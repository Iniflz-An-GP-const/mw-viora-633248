    <string-array name="about_rules">
        <item>पूरा बोर्ड कुछ सेकंड तक खुला रहता है। हर कार्ड की जगह याद कर लें।</item>
        <item>कार्डों के उलट जाने पर किसी कार्ड को खोलने के लिए उस पर टैप करें।</item>
        <item>खोले गए कार्ड से मेल खाने वाला कार्ड ढूँढें।</item>
        <item>स्तर चुनें: अधिक कठिन स्तर में बोर्ड पर अधिक कार्ड होते हैं।</item>
    </string-array>
